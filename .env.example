# =============================================================
# Providers
# =============================================================
# Pick a provider, then fill in the matching subsection below.
PROVIDER=ollama                          # ollama | llamacpp

# --- Ollama --------------------------------------------------
OLLAMA_HOST=http://host.docker.internal:11434
MODEL=gpt-oss:latest
# Web-search API key — optional, only the web_search tool needs it (https://ollama.com/settings/keys)
# OLLAMA_API_KEY=xxxxxxxxxxxx
OLLAMA_USE_THINKING=true

# --- llama.cpp -----------------------------------------------
# Start the server first, e.g.
# llama-server -hf Jackrong/Qwopus3.6-35B-A3B-Coder-MTP-GGUF:Q5_K_M --n-gpu-layers 99 --cpu-moe --ctx-size 65536 --flash-attn on --jinja --temp 0.7 --top-p 0.8 --top-k 20 --threads 8 --host 0.0.0.0 --port 8080
# llama-server -hf unsloth/Qwen3-Coder-Next-GGUF:UD-Q4_K_XL --n-gpu-layers 99 --cpu-moe --ctx-size 65536 --flash-attn on --jinja --temp 1.0 --top-p 0.95 --top-k 40 --min-p 0.0 --repeat-penalty 1.0 --threads 8 --host 0.0.0.0 --port 8080
# llama-server -hf unsloth/gpt-oss-20b-GGUF:UD-Q8_K_XL --n-gpu-layers 99 --n-cpu-moe 8 --ctx-size 65536 --flash-attn on --jinja --temp 1.0 --top-p 1.0 --top-k 0 --threads 8 --host 0.0.0.0 --port 8080
# llama-server -hf unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q8_K_XL --n-gpu-layers 99 --cpu-moe --ctx-size 65536 --flash-attn on --jinja --reasoning-format deepseek --temp 0.6 --top-p 0.95 --top-k 20 --threads 8 --host 0.0.0.0 --port 8080
# --reasoning-budget 0 (for speed), 1 (for effort)
# then set:
LLAMACPP_HOST=http://host.docker.internal:8080
# MODEL is ignored (the server serves the one loaded model)
# --jinja enables the model's chat template + native tool calling (USE_NATIVE_TOOLS=true);
# without it, set USE_NATIVE_TOOLS=false to fall back to prompt-engineered tools.

# --- Behavior ---
LANGUAGE=russian
# Optional character for the assistant: path to a markdown file appended to the end of the
# system prompt. With a persona loaded the terse-assistant style rules step aside (the persona
# sets voice and length), a short in-character reminder is appended to every request, and the
# spoken-style reminder drops its own tone advice — tools, modes, and permissions are untouched.
# Relative paths resolve against the directory holding this .env, so the same persona is
# picked up whichever directory you run sup in.
# The persona also picks the language it speaks, so LANGUAGE above only applies when the
# persona says nothing about it; a persona written in the other script (Cyrillic against
# LANGUAGE=english, or Latin against LANGUAGE=russian) is called out at startup, because
# the voice settings below are picked per language and would read the wrong one aloud.
# Empty = no persona. Unreadable file = a warning and a normal session.
# Roleplay needs room: raise TEMPERATURE to about 0.8 for the run, the 0.2 default sounds flat.
PERSONA_FILE=
# Skills are read from `.sup/skills` in the directory you run sup in, so every project brings its own.
# With this on, `.claude/skills` there is read too: Claude Code skill folders load as-is, but mind that
# skills written for frontier models are long and branchy. A name in `.sup/skills` wins the collision.
USE_CLAUDE_SKILLS=false
# Starting mode (Shift+Tab cycles normal → auto → plan at runtime).
# Auto is the default; USE_AUTO_MODE=false starts in normal mode, where every edit asks first.
USE_PLAN_MODE=false   # start in plan mode; wins over USE_AUTO_MODE
USE_AUTO_MODE=true    # start in auto mode (auto-approve edits without asking)
USE_READ_ONLY_MODE=false   # session-wide read-only toolset; same as starting with `sup --read-only`
USE_SHELL_TOOL=true

# --- Generation / tools (provider-agnostic) ---
USE_NATIVE_TOOLS=true       # use the provider's native tool-calling API; false = prompt-engineered fallback
CONTEXT_WINDOW_TOKEN_LIMIT=80000
REQUEST_TIMEOUT_MS=300000   # HTTP idle timeout for a model request
REQUEST_FIRST_TOKEN_TIMEOUT_MS=600000   # timeout for the first token (covers model load and prompt processing)
TEMPERATURE=0.2
MAX_RESPONSE_TOKENS=8192    # hard cap on tokens per model response: num_predict / max_tokens (0 = provider default)
REPEAT_PENALTY=1.1          # sampling penalty against token repetition (0 = provider default)
SHOW_THINKING=true
USE_STREAMING=true

# --- Loop detection ---
# Cuts a streamed response as soon as it degenerates into repeating the same text:
# the looped tail is trimmed to a single cycle and the model is told why it was stopped.
USE_LOOP_DETECTION=true
THINKING_CHAR_LIMIT=30000   # also stop a response whose thinking exceeds this many characters

# --- Tool limits ---
WEB_SEARCH_MAX_RESULTS=5
FETCH_URL_MAX_BYTES=50000
FETCH_URL_TIMEOUT_MS=15000

# --- Context hygiene ---
USE_TOOL_RESULT_COLLAPSE=true
TOOL_RESULT_KEEP_RECENT=8
TOOL_RESULT_COLLAPSE_MIN_CHARS=1500
TOOL_RESULT_COLLAPSE_BATCH=4

# --- Autonomous loop ---
AUTONOMOUS_STEP_BUDGET=100
AUTONOMOUS_REPEAT_THRESHOLD=3

# --- Journal (run logs) ---
# Event-sourced log of every run in .sup/runs/<id>/journal.jsonl; enables `sup --resume`.
# On by default; independent of the babysitter.
USE_JOURNAL=true

# --- Babysitter (deterministic control: verification gate, ledger, gated skills) ---
# Master switch (off by default). The sub-toggles below only apply when this is on.
USE_BABYSITTER=false
# Forced stop before finishing: run the plan/skill Verification checks; block finish until they pass.
BABYSITTER_VERIFICATION_GATE=true
# Structured step ledger re-injected each turn; adds the ledger_update tool.
BABYSITTER_LEDGER=true
# Skills with a "Steps" section drive the model step-by-step and gate on their Verification.
BABYSITTER_GATED_SKILLS=true
# Safety valve: give up and allow finish after this many failed gate attempts.
BABYSITTER_GATE_MAX_ATTEMPTS=3

# --- UI ---
VERBOSE_TOOL_OUTPUT=false

# --- Text to speech -------------------------------------------
# Speaks the model's answers out loud through a local Silero v5 server
# (29 Russian voices with stress marks). Start it first — it keeps the model
# in memory: pip install silero silero-stress soundfile flask, then serve
# POST /synthesize taking {"text": "..."} and answering with a wav body.
# These are starting values only — /tts toggles speech during a session.
# Thinking, tool output, and proposed plans are never spoken; code blocks and
# tables are skipped. Playback goes through paplay (package pulseaudio-utils).
# Port 5012 instead serves Chatterbox (cloned voices from a sample clip, same contract);
# it is slower, so raise TTS_TIMEOUT_MS along with it. Port 5013 serves Qwen3-TTS, also
# cloned voices, slower still, but it clones a Russian voice — which Chatterbox cannot.
# See voice-servers/README.md.
# With speech on, the harness appends a spoken-style reminder to each request
# (conversational sentences, no markdown, no paths read aloud) and speaks the
# final answer only — comments before tool calls stay on screen, unspoken. So does
# the report after a turn the harness had to stop: it names files and results, which
# is what you want to read and the last thing you want dictated.
USE_TTS=false
TTS_HOST=http://127.0.0.1:5011
# Empty = whatever voice the server was started with.
# On the Silero server this picks one of its voices (ru_eduard, ru_ekaterina, …).
# On the Chatterbox and Qwen3-TTS servers it is the name of a sample clip in their
# voices directory; Qwen3-TTS has no built-in voice at all, so it needs one.
TTS_VOICE=
# Empty = whatever language the server was started with, which is the normal case
# (Silero ignores this field; Qwen3-TTS detects the language from the text itself).
# Set it only to override that for one session: on the Chatterbox server it is the
# language the text is read in — en, de, fr, …
# Whatever it ends up being, LANGUAGE above has to agree with it: that is the language
# the model answers in, and text read under the wrong rules comes out as mush.
TTS_LANGUAGE=
# Optional pronunciation lexicon: path to a file of `written = spoken` lines, applied to
# the text on its way to the synthesizer only — the screen keeps the normal spelling.
# For fixing names the model gets wrong: stress, transliteration, initialisms. What the
# right-hand side should look like is a property of your server (a capital letter is how
# Qwen3-TTS hears stress; Silero wants a + before the stressed vowel), so find it by ear.
# Lines starting with # are comments, matching ignores case and needs a whole word;
# end the left side with * to match a stem and keep the ending (`Тьюринг* = ТьЮринг`
# also fixes «Тьюринга» and «Тьюрингу»). Empty = no substitutions.
# Relative paths resolve against the directory holding this .env, like PERSONA_FILE above.
TTS_LEXICON_FILE=
# Keep answers as short with speech on as they are with it off. By default the
# spoken-style reminder also sets the pacing — the answer first, a couple of
# sentences of detail after it — which is roomier than the written style rules.
# True drops that and points the model back at those rules ("be brief, 1-3 short
# lines"), so only the wording turns speakable: no markdown, no dictated paths.
# Ignored with a persona — there the persona alone decides how much you hear.
VOICE_MODE_SHORT=false
# Give up on a synthesis request after this long and turn speech off.
# A server that stops answering flips USE_TTS back to false, so the spoken-style
# reminder stops as well — /tts turns both on again once it is fixed.
TTS_TIMEOUT_MS=30000

# --- Speech to text -------------------------------------------
# Ctrl+G starts dictation; Enter stops it and sends the recognised text,
# Ctrl+G stops it and only inserts the text at the cursor, Esc drops the
# recording. Recording goes through parecord (pulseaudio-utils).
# Recognition expects a local HTTP server: POST /transcribe takes a 16 kHz
# mono wav body and answers with {"text": "..."} — a dozen lines around
# faster-whisper (pip install faster-whisper flask).
# See voice-servers/README.md for a ready one.
# Ctrl+C and Ctrl+D during a recording drop it and reach the prompt as usual.
# On by default: nothing runs until Ctrl+G is pressed, so an unused dictation
# costs nothing. This is a starting value only — /stt toggles it during a session.
USE_STT=true
STT_HOST=http://127.0.0.1:5001
# Empty = default input; or a name from `pactl list short sources`.
STT_DEVICE=
# Recognition of a long dictation is slow, so keep this generous.
STT_TIMEOUT_MS=120000
