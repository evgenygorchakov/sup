# Ollama web-search API key — optional, only the web_search tool needs it (https://ollama.com/settings/keys)
# OLLAMA_API_KEY=xxxxxxxxxxxx

# --- Provider / model ---
# PROVIDER=ollama
# HOST=http://host.docker.internal:11434
# MODEL=qwen3.6
# LANGUAGE=russian

# --- Behavior ---
# USE_PLAN_MODE=false
# USE_READ_ONLY_MODE=false
# USE_AUTONOMOUS_MODE=true
# USE_PERMISSION_ALLOWLIST=true
# USE_SHELL_TOOL=true

# --- Ollama specifics ---
# USE_NATIVE_OLLAMA_TOOLS=true
# CONTEXT_WINDOW_TOKEN_LIMIT=80000
# OLLAMA_REQUEST_TIMEOUT_MS=300000
# TEMPERATURE=0.2
# USE_THINKING=true
# SHOW_THINKING=true
# USE_STREAMING=true

# --- Tool limits ---
# WEB_SEARCH_MAX_RESULTS=5
# FETCH_URL_MAX_BYTES=50000
# FETCH_URL_TIMEOUT_MS=15000

# --- Context hygiene ---
# USE_TOOL_RESULT_COLLAPSE=true
# TOOL_RESULT_KEEP_RECENT=8
# TOOL_RESULT_COLLAPSE_MIN_CHARS=1500

# --- Autonomous loop ---
# AUTONOMOUS_STEP_BUDGET=100
# AUTONOMOUS_REPEAT_THRESHOLD=3

# --- Babysitter (deterministic control: verification gate, journal, ledger, gated skills) ---
# Master switch (off by default). The sub-toggles below only apply when this is on.
# USE_BABYSITTER=false
# Forced stop before finishing: run the plan/skill Verification checks; block finish until they pass.
# BABYSITTER_VERIFICATION_GATE=true
# Event-sourced log of every step in .sup/runs/<id>/journal.jsonl; enables `sup --resume`.
# BABYSITTER_JOURNAL=true
# Structured step ledger re-injected each turn; adds the ledger_update tool.
# BABYSITTER_LEDGER=true
# Skills with a "Steps" section drive the model step-by-step and gate on their Verification.
# BABYSITTER_GATED_SKILLS=true
# Safety valve: give up and allow finish after this many failed gate attempts.
# BABYSITTER_GATE_MAX_ATTEMPTS=3

# --- UI ---
# VERBOSE_TOOL_OUTPUT=false
