# =============================================================
# Providers
# =============================================================
# Pick a provider, then fill in the matching subsection below.
PROVIDER=ollama                          # ollama | llamacpp

# --- Ollama --------------------------------------------------
OLLAMA_HOST=http://host.docker.internal:11434
MODEL=qwen3.6
# Web-search API key — optional, only the web_search tool needs it (https://ollama.com/settings/keys)
# OLLAMA_API_KEY=xxxxxxxxxxxx
OLLAMA_USE_THINKING=true

# --- llama.cpp -----------------------------------------------
# Start the server first, e.g.
# llama-server -m model.gguf -c 8192 --jinja --port 8080
# llama-server -hf Jackrong/Qwopus3.6-27B-Coder-GGUF:Q4_K_M --device Vulkan0 --no-mmproj -fa on -c 60000 --cache-type-k q8_0 --cache-type-v q8_0 --jinja --reasoning-format deepseek --reasoning-budget -1 --host 0.0.0.0 --port 8080
# then set:
LLAMACPP_HOST=http://localhost:8080
# MODEL is ignored (the server serves the one loaded model)
# --jinja enables the model's chat template + native tool calling (USE_NATIVE_TOOLS=true);
# without it, set USE_NATIVE_TOOLS=false to fall back to prompt-engineered tools.

# --- Behavior ---
LANGUAGE=russian
# Starting mode (Shift+Tab cycles normal → auto → plan at runtime):
USE_PLAN_MODE=false   # start in plan mode
USE_AUTO_MODE=false   # start in auto mode (auto-approve edits without asking)
USE_READ_ONLY_MODE=false   # session-wide read-only toolset; same as starting with `sup --read-only`
USE_SHELL_TOOL=true

# --- Generation / tools (provider-agnostic) ---
USE_NATIVE_TOOLS=true       # use the provider's native tool-calling API; false = prompt-engineered fallback
CONTEXT_WINDOW_TOKEN_LIMIT=80000
REQUEST_TIMEOUT_MS=300000   # HTTP idle timeout for a model request
REQUEST_FIRST_TOKEN_TIMEOUT_MS=600000   # timeout for the first token (covers model load and prompt processing)
TEMPERATURE=0.2
SHOW_THINKING=true
USE_STREAMING=true

# --- Tool limits ---
WEB_SEARCH_MAX_RESULTS=5
FETCH_URL_MAX_BYTES=50000
FETCH_URL_TIMEOUT_MS=15000

# --- Context hygiene ---
USE_TOOL_RESULT_COLLAPSE=true
TOOL_RESULT_KEEP_RECENT=8
TOOL_RESULT_COLLAPSE_MIN_CHARS=1500

# --- Autonomous loop ---
AUTONOMOUS_STEP_BUDGET=100
AUTONOMOUS_REPEAT_THRESHOLD=3

# --- Journal (run logs) ---
# Event-sourced log of every run in .sup/runs/<id>/journal.jsonl; enables `sup --resume`.
# On by default; independent of the babysitter.
USE_JOURNAL=true

# --- Babysitter (deterministic control: verification gate, ledger, gated skills) ---
# Master switch (off by default). The sub-toggles below only apply when this is on.
USE_BABYSITTER=false
# Forced stop before finishing: run the plan/skill Verification checks; block finish until they pass.
BABYSITTER_VERIFICATION_GATE=true
# Structured step ledger re-injected each turn; adds the ledger_update tool.
BABYSITTER_LEDGER=true
# Skills with a "Steps" section drive the model step-by-step and gate on their Verification.
BABYSITTER_GATED_SKILLS=true
# Safety valve: give up and allow finish after this many failed gate attempts.
BABYSITTER_GATE_MAX_ATTEMPTS=3

# --- UI ---
VERBOSE_TOOL_OUTPUT=false
