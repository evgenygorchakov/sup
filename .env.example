# Ollama web-search API key (https://ollama.com/settings/keys)
# OLLAMA_API_KEY=xxxxxxxxxxxx

# --- Provider / model ---
# PROVIDER=ollama
# HOST=http://host.docker.internal:11434
# MODEL=qwen3.6
# LANGUAGE=russian

# --- Behavior ---
# USE_PLAN_MODE=false
# USE_AUTONOMOUS_MODE=false
# USE_RESEARCH_MODE=true
# USE_PERMISSION_ALLOWLIST=true
# Allow the run_shell tool. Disabled by default: the agent is confined to the
# working directory (file tools already refuse paths outside it). Set to true to
# grant unsandboxed access to arbitrary shell commands.
# USE_SHELL_TOOL=false

# --- Ollama specifics ---
# USE_NATIVE_OLLAMA_TOOLS=true
# CONTEXT_WINDOW_TOKEN_LIMIT=80000
# USE_THINKING=true
# SHOW_THINKING=true
# USE_STREAMING=true

# --- Tool limits ---
# WEB_SEARCH_MAX_RESULTS=5
# FETCH_URL_MAX_BYTES=200000
# FETCH_URL_TIMEOUT_MS=15000

# --- Autonomous loop ---
# AUTONOMOUS_STEP_BUDGET=100
# AUTONOMOUS_REPEAT_THRESHOLD=3

# --- UI ---
# VERBOSE_TOOL_OUTPUT=false
