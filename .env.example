# Providers
PROVIDER=ollama

# Ollama
OLLAMA_HOST=http://host.docker.internal:11434
# Leave MODEL empty to auto-pick the most recently pulled model (/api/tags).
MODEL=
OLLAMA_API_KEY=
# Thinking is used only if the model reports the capability in /api/show; otherwise it stays off.
OLLAMA_USE_THINKING=true

# llama.cpp
LLAMACPP_HOST=http://host.docker.internal:8080

# llama serve -hf  ggml-org/Qwen3.8-27B-GGUF:Q4_K_M -hfd ggml-org/Qwen3.8-27B-GGUF:Q4_0 --spec-default --spec-type draft-mtp --ctx-size 196608 --cache-type-k q8_0 --cache-type-v q8_0 --reasoning-preserve --fit off --agent
# llama-server -hf unsloth/gpt-oss-20b-GGUF:UD-Q8_K_XL --n-gpu-layers 99 --n-cpu-moe 8 --ctx-size 65536 --flash-attn on --jinja --temp 1.0 --top-p 1.0 --top-k 0 --threads 8 --host 0.0.0.0 --port 8080
# The sampling flags above survive only while TEMPERATURE below is empty or commented out: a value there overrides them.
# --reasoning-budget 0 (for speed), 1 (for effort)

# Behavior
LANGUAGE=russian
USE_CLAUDE_SKILLS=false
USE_PLAN_MODE=false
USE_AUTO_MODE=true
USE_SHELL_TOOL=true
USE_ASK_USER=true

# Generation / tools
CONTEXT_WINDOW_TOKEN_LIMIT=80000
REQUEST_TIMEOUT_MS=300000
REQUEST_FIRST_TOKEN_TIMEOUT_MS=600000
MAX_RESPONSE_TOKENS=8192
# An empty field is not sent at all, and the values the model was shipped with apply — the ones from
# its Modelfile, or the flags llama-server was started with. A value here wins over both.
# TEMPERATURE is 0..2 and /temp changes it mid-session. 0.2 is not a guess: on the live suite it ran
# ~20% faster than the model's own 1.0 at identical verdicts, on qwen3.8:27b-q8_0.
# REPEAT_PENALTY is 1..2 and stays empty: measured on the same model, nothing below 1.5 changes
# anything at all (see test/bench/sampling.ts).
TEMPERATURE=0.2
# REPEAT_PENALTY=1.1
SHOW_THINKING=true
USE_STREAMING=true

# Loop detection
USE_LOOP_DETECTION=true
THINKING_CHAR_LIMIT=30000

# Tool limits
# Where web_search goes: ollama (needs OLLAMA_API_KEY) or searxng (needs WEB_SEARCH_HOST)
# /search-provider switches between them mid-session
WEB_SEARCH_PROVIDER=ollama
# SearxNG instance, e.g. http://localhost:8888; setup is in optional/searxng/README.md
WEB_SEARCH_HOST=
WEB_SEARCH_MAX_RESULTS=10
# Page text per result: 0 keeps the reply to titles and URLs, above 0 adds an excerpt around the query
WEB_SEARCH_RESULT_CHARS=0
FETCH_URL_MAX_BYTES=2000000
FETCH_URL_TIMEOUT_MS=15000
# How long a fetched page stays reusable, so re-reads and offset windows cost nothing
FETCH_URL_CACHE_TTL_MS=900000
# How many headings fetch_url lists as the section map; 0 hides it
FETCH_URL_OUTLINE_MAX_ENTRIES=60

# Context hygiene
USE_TOOL_RESULT_COLLAPSE=true
TOOL_RESULT_KEEP_RECENT=8
TOOL_RESULT_COLLAPSE_MIN_CHARS=1500
TOOL_RESULT_COLLAPSE_BATCH=4

# Autonomous loop
AUTONOMOUS_STEP_BUDGET=100
AUTONOMOUS_REPEAT_THRESHOLD=3

# Journal (run logs)
USE_JOURNAL=false

# UI
VERBOSE_TOOL_OUTPUT=false

# Optional features — off by default, each needs its own install first: optional/README.md

# Speech to text (dictation): local whisper server — optional/voice/README.md
# pactl list short sources
USE_STT=false
STT_HOST=http://127.0.0.1:5001
STT_DEVICE=
STT_TIMEOUT_MS=120000

# Text to speech: local Silero server — optional/voice/README.md
# USE_TTS=true sup
USE_TTS=false
TTS_HOST=http://127.0.0.1:5011
# Silero voices: aidar (m), eugene (m), baya (f), kseniya (f), xenia (f)
TTS_VOICE=aidar
# Speech rate: x-slow, slow, medium, fast, x-fast
TTS_RATE=medium
TTS_TIMEOUT_MS=30000

# Clipboard glued to the end of what you dictate (/clipboard toggles it mid-session)
USE_DICTATION_CLIPBOARD=true
CLIPBOARD_MAX_CHARS=20000

# PDF to markdown: drop a PDF into the terminal and it lands as .md in the current directory,
# and that is all it does — the text never goes into the context
# Needs the marker converter — optional/pdf/README.md
USE_PDF_CONVERT=false
PDF_CONVERTER=pdf-to-md
# No daemon behind it: every file reloads the models, so give it room
PDF_TIMEOUT_MS=900000
PDF_EXTRACT_IMAGES=false
