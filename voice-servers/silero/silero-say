#!/bin/sh
# silero-say [-s <голос>] <текст...>   — синтезирует фразу и играет её
set -e

host="${SILERO_HOST:-http://127.0.0.1:5011}"
voice=""

if [ "$1" = "-s" ]; then
    voice="$2"
    shift 2
fi

if [ $# -lt 1 ]; then
    echo "использование: silero-say [-s <голос>] <текст...>" >&2
    echo "голоса:" >&2
    curl -s "$host/voices" >&2
    echo >&2
    exit 2
fi

body=$(python3 -c 'import json,sys
voice, *words = sys.argv[1:]
payload = {"text": " ".join(words)}
if voice:
    payload["voice"] = voice
print(json.dumps(payload))' "$voice" "$@")
out="${TMPDIR:-/tmp}/silero-say.wav"

code=$(curl -s -o "$out" -w '%{http_code}' -X POST "$host/synthesize" \
    -H 'Content-Type: application/json' --data "$body")

if [ "$code" != "200" ]; then
    echo "сервер ответил $code:" >&2
    cat "$out" >&2
    echo >&2
    exit 1
fi

exec paplay "$out"
