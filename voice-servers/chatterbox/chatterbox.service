[Unit]
Description=Chatterbox multilingual text-to-speech server with voice cloning
After=default.target

[Service]
ExecStart=%h/.local/bin/chatterbox-serve
WorkingDirectory=%h/.local/share/chatterbox
Environment=HF_HOME=%h/.local/share/chatterbox/models
Environment=CHATTERBOX_LANGUAGE=en
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
